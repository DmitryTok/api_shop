# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================

# Application environment. Allowed values: local, staging, production.
# For local development use "local".
APP_ENV=local

# Django debug mode. Allowed values: true or false.
# Must always be false for staging and production.
DEBUG=true


# ==============================================================================
# DJANGO SECURITY AND JWT
# ==============================================================================

# Django secret key used for cryptographic signing and JWT signing.
# Generate a unique secret for every environment. Never commit a real value.
# Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET=replace-with-a-long-random-secret

# JWT signing algorithm. HS256 is the current application default.
ALGORITHM=HS256


# ==============================================================================
# ALLOWED BACKEND HOSTS
# ==============================================================================

# Comma-separated hostnames accepted by Django.
# Do not include http://, https://, paths, or a trailing slash.
# Local example: localhost,127.0.0.1
# Staging example: api-shop-staging.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ==============================================================================
# TEMPORARY DJANGO SUPERUSER
# ==============================================================================

# Credentials used by the temporary superuser creation script.
# Leave empty if automatic superuser creation is not required.
# Remove this mechanism from the production startup process later.
SUPER_LOGIN=
SUPER_PASSWORD=


# ==============================================================================
# POSTGRESQL DATABASE
# ==============================================================================

# Reserved for selecting a database backend.
# The current settings.py does not read DB_ENGINE and always uses PostgreSQL.
DB_ENGINE=django.db.backends.postgresql

# PostgreSQL database name.
DB_NAME=api_shop

# PostgreSQL user.
DB_USER=postgres

# PostgreSQL password. Replace it in the real .env file.
DB_PASSWORD=replace-with-a-database-password

# PostgreSQL host.
# Use "db" when Django runs in Docker Compose with the database service.
# Use the hostname supplied by Neon for staging and production.
DB_HOST=db

# PostgreSQL container port. Inside Docker Compose this is normally 5432,
# even when PostgreSQL is published on another host port such as 5433.
DB_PORT=5432


# ==============================================================================
# ATTEMPT LIMITS
# ==============================================================================

# Maximum number of password-reset attempts. Must be an integer.
MAX_PASSWORD_RESET_ATTEMPTS=3

# Maximum number of refresh-token attempts. Must be an integer.
MAX_REFRESH_ATTEMPTS=5


# ==============================================================================
# TOKEN TIMEOUTS
# ==============================================================================

# Password-reset timeout in hours. Must be an integer.
PASSWORD_RESET_TIMEOUT_HR=24

# Refresh-token timeout in hours. Despite the variable name, settings.py
# currently treats this value as hours and converts it to seconds.
REFRESH_TOKEN_TIMEOUT=24


# ==============================================================================
# EMAIL
# ==============================================================================

# Informational value for the selected email backend.
# The current settings.py does not read EMAIL_BACKEND from the environment;
# it always uses Anymail with Brevo.
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend

# SMTP settings below are reserved for a possible SMTP configuration.
# The current settings.py does not read these variables.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Brevo API key used by the current Anymail configuration.
BREVO_API_KEY=

# Verified sender address used in outgoing messages.
DEFAULT_FROM_EMAIL=noreply@example.com


# ==============================================================================
# CORS AND CSRF
# ==============================================================================

# Comma-separated frontend origins allowed to call the API from a browser.
# Include the scheme and port. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated origins trusted by Django for CSRF-protected requests.
# Include the scheme and port. Do not add a trailing slash.
CSRF_TRUSTED_ORIGINS=http://localhost:3000


# ==============================================================================
# CLOUDINARY MEDIA STORAGE
# ==============================================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ==============================================================================
# CELERY AND REDIS
# ==============================================================================

# Redis logical database 0 is used as the Celery message broker.
CELERY_BROKER_URL=redis://redis:6379/0

# Redis logical database 1 is used for the Django cache.
REDIS_URL=redis://redis:6379/1
